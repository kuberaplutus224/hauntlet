      }
    },
    {
      "name": "foreign, expired and unknown events are ignored",
      "events": [
        {"run_id": "run-B", "room": "repo", "trap_id": "readme", "channel": "network", "signal": "exposed"},
        {"room": "repo", "trap_id": "readme", "channel": "network", "signal": "exposed", "expired": true},
        {"room": "attic", "trap_id": "readme", "channel": "network", "signal": "acted"},
