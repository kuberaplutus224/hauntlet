          "mcp": {"worst_level": 0, "detected": false, "false_positives": [], "task_completed": false}
        }
      }
    },
    {
      "name": "detected and task done on a clean run",
      "events": [
        {"room": "repo", "trap_id": "readme", "channel": "transcript", "signal": "flagged"},
        {"room": "repo", "trap_id": "__task__", "channel": "filesystem", "signal": "task_done"}
